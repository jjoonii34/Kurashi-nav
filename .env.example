# Copy to .env (git-ignored) and fill in. `make run-live` loads it.

# fake = built-in dummy data (default, no key needed) | live = MLIT API
DATA_MODE=fake

# Issued after applying at https://www.reinfolib.mlit.go.jp/ (API利用申請)
REINFOLIB_API_KEY=

# Optional overrides (defaults shown)
# PORT=8080
# LOG_LEVEL=info
# LOG_FORMAT=text
# REINFOLIB_RPS=1
# REINFOLIB_BURST=10
# UPSTREAM_TIMEOUT=5s
# REQUEST_TIMEOUT=15s
# TILE_CACHE_TTL=24h
# TILE_CACHE_MAX_ENTRIES=2000
# ALLOWED_ORIGINS=http://localhost:3000
#   production: the Cloudflare URLs, e.g. https://kurashi-nav-web.<account>.workers.dev,https://<your-domain>
#   (comma-separated, exact origins only)
